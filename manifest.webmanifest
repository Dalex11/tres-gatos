---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "lang": "es-CO",
  "id": "{{ '/' | relative_url }}",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0d0c0b",
  "theme_color": "#c5170e",
  "categories": ["news", "education", "books"],
  "icons": [
    { "src": "{{ '/assets/img/pwa/icono-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/assets/img/pwa/icono-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/assets/img/pwa/icono-maskable-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Buscar", "url": "{{ '/buscar/' | relative_url }}" }
  ]
}
